# Environment Configuration Template
NODE_ENV=development
PORT=5000

# Database
# If MONGODB_URI is provided, connects to MongoDB Atlas or local MongoDB.
# If omitted or unavailable in dev, the server automatically starts embedded MongoDB for frictionless development.
MONGODB_URI=mongodb://localhost:27017/requirementform
ALLOW_IN_MEMORY_DB=true

# Security Secrets (Must be 32+ characters in production)
JWT_SECRET=production_grade_jwt_secret_key_change_me_32char_minimum_length
COOKIE_SECRET=production_grade_cookie_secret_change_me_32char_minimum_length

# CORS and Client
CLIENT_URL=http://localhost:5173

# Default System Brand (Configurable in DB afterwards)
DEFAULT_BRAND_NAME=Weblets
DEFAULT_BRAND_COLOR=#FF6B00

# Initial Admin Credentials for Seeding
ADMIN_EMAIL=admin@agency.com
ADMIN_PASSWORD=Admin@Agency2026!
